FROM node:20-alpine AS build
WORKDIR /app
COPY src/POS.Frontend/package*.json ./
RUN npm ci
COPY src/POS.Frontend/ ./
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY src/POS.Frontend/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

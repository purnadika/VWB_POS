/// <summary>
/// Handler for ListActiveUsersQuery.
/// Returns paginated list of active users.
/// </summary>
public class ListActiveUsersQueryHandler : IRequestHandler<ListActiveUsersQuery, Result<PagedResult<UserResponse>>>
{
    private readonly IUserRepository _userRepository;
    private readonly ILogger<ListActiveUsersQueryHandler> _logger;

    public ListActiveUsersQueryHandler(
        IUserRepository userRepository,
        ILogger<ListActiveUsersQueryHandler> logger)
    {
        _userRepository = userRepository;
        _logger = logger;
    }

    public async Task<Result<PagedResult<UserResponse>>> Handle(
        ListActiveUsersQuery request,
        CancellationToken cancellationToken)
    {
        try
        {
            // Validate pagination parameters
            var pageNumber = Math.Max(1, request.PageNumber);
            var pageSize = Math.Min(Math.Max(1, request.PageSize), DefaultValues.MaxPageSize);

            var allUsers = await _userRepository.GetActiveUsersAsync(cancellationToken);
            var totalCount = allUsers.Count();

            var items = allUsers
                .Skip((pageNumber - 1) * pageSize)
                .Take(pageSize)
                .Select(MapUserToResponse)
                .ToList();

            var result = new PagedResult<UserResponse>
            {
                Items = items,
                PageNumber = pageNumber,
                PageSize = pageSize,
                TotalCount = totalCount
            };

            return Result<PagedResult<UserResponse>>.Success(result);
        }
        catch (Exception ex)
        {
            _logger.LogError($"Error listing active users: {ex.Message}");
            var errorMessage = new LocalizationService(
                Microsoft.Extensions.Logging.LoggerFactory.Create(builder => { }).CreateLogger<LocalizationService>()
            ).GetString(LocalizationKeys.DatabaseError);
            return Result<PagedResult<UserResponse>>.Failure(errorMessage);
        }
    }

    private static UserResponse MapUserToResponse(User user)
    {
        return new UserResponse
        {
            Id = user.Id,
            Email = user.Email.Value,
            FullName = user.FullName,
            PhoneNumber = user.PhoneNumber,
            Role = user.Role,
            Permissions = user.Permissions.ToList(),
            IsActive = user.IsActive,
            CreatedAt = user.CreatedAt,
            CreatedBy = user.CreatedBy,
            LastModifiedAt = user.LastModifiedAt,
            LastModifiedBy = user.LastModifiedBy,
            LastLoginAt = user.LastLoginAt
        };
    }
}


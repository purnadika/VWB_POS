/// <summary>
/// Handler for CheckUserPermissionQuery.
/// </summary>
public class CheckUserPermissionQueryHandler : IRequestHandler<CheckUserPermissionQuery, Result<bool>>
{
    private readonly IUserRepository _userRepository;
    private readonly ILocalizationService _localizationService;
    private readonly ILogger<CheckUserPermissionQueryHandler> _logger;

    public CheckUserPermissionQueryHandler(
        IUserRepository userRepository,
        ILocalizationService localizationService,
        ILogger<CheckUserPermissionQueryHandler> logger)
    {
        _userRepository = userRepository;
        _localizationService = localizationService;
        _logger = logger;
    }

    public async Task<Result<bool>> Handle(
        CheckUserPermissionQuery request,
        CancellationToken cancellationToken)
    {
        try
        {
            var user = await _userRepository.GetByIdAsync(request.UserId, cancellationToken);
            if (user == null)
            {
                return Result<bool>.Success(false);
            }

            var hasPermission = user.HasPermission(request.Permission);
            return Result<bool>.Success(hasPermission);
        }
        catch (Exception ex)
        {
            _logger.LogError($"Error checking permission: {ex.Message}");
            return Result<bool>.Failure("Error checking permission");
        }
    }
}
